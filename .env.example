# Environment variables for Precedent

# Backend
BACKEND_URL=http://localhost:8000

# Frontend (used by FastAPI CORS)
FRONTEND_URL=http://localhost:5173

# Frontend Vite env (set in frontend/.env.local)
# VITE_API_URL=http://localhost:8000

# SQLite database path (default: backend/precedent.db)
# DATABASE_URL=sqlite:///./backend/precedent.db

# ── Phase 2: Hindsight memory (optional) ─────────────────────────────────────
# Backend continues without these; memory hook logs and continues on failure.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=precedent-demo
